{
  "name": "textstats",
  "productName": "TextStats",
  "version": "1.0.2",
  "description": "Read text documents and e-books and report word, character and vocabulary statistics.",
  "main": "src/main/main.js",
  "author": "JP",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.jp.textstats",
    "productName": "TextStats",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  }
}
